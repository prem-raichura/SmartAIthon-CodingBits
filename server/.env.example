NODE_ENV=development
PORT=4000

# Local PostgreSQL (Postgres.app / Homebrew / Docker). Create the DB first:
#   createdb officer_app
DATABASE_URL="postgresql://USER@localhost:5432/officer_app?schema=public"

# Must be at least 32 characters.
JWT_SECRET=change_me_to_a_random_string_of_32_plus_chars
JWT_EXPIRES_IN=30d

# Comma-separated. Any localhost/127.0.0.1/private-LAN origin is allowed
# automatically, so this only needs entries for deployed frontends.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:19006

# Express JSON body limit. Lower to 4mb behind a serverless host.
JSON_BODY_LIMIT=25mb

# Local Flask model service (model/app.py).
PY_SERVICE_URL=http://localhost:8077

GEOFENCE_RADIUS_M=500
REMINDER_CRON=*/5 * * * *

# stub = no network at all (emails are logged, not sent).
EMAIL_MODE=stub
# EMAIL_MODE=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=password
# SMTP_FROM="Officer App <noreply@example.com>"

# stub = no network at all.
PUSH_MODE=stub
# PUSH_MODE=expo

# Optional. Leave unset to store officer photos on local disk (server/uploads)
# and serve them from /uploads.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optional. Absolute origin used to build URLs for locally stored uploads.
# Set this when the API is reached by LAN IP (e.g. from a phone).
# PUBLIC_URL=http://192.168.1.10:4000
