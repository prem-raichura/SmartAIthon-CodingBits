# ─────────────────────────────────────────────────────────────────────────────
# SmartAIThon — root ignore rules
#
# Monorepo: client/ (Vite web portal) · server/ (Express API) · mobile/ (Expo)
# · model/ (Flask ML service). Each package also has its own .gitignore; these
# rules apply repo-wide so nothing slips through from the root.
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets — never commit ───────────────────────────────────────────────────
# server/.env holds SMTP credentials and the Cloudinary API secret.
.env
.env.*
!.env.example
!.env.*.example

*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
secrets.json
credentials.json
service-account*.json

# Firebase / push config (add these locally when you wire up remote push)
google-services.json
GoogleService-Info.plist

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# Python
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ── Build output ─────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
out/
web-build/
*.tsbuildinfo

# Expo / React Native
.expo/
.expo-shared/
expo-env.d.ts
.metro-health-check*
.kotlin/
# Generated by `expo prebuild` — regenerate rather than commit
/mobile/ios/
/mobile/android/
*.orig.*

# ── Runtime artifacts ────────────────────────────────────────────────────────
# Officer photos written to disk when Cloudinary is not configured
server/uploads/
server/upload/
*.js.map

# ML training scratch
catboost_info/
model/shap/*.pkl
mlruns/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Editors / OS ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

.vscode
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ── Tooling / deploy caches ──────────────────────────────────────────────────
.vercel
.turbo
.cache/
.eslintcache
coverage/
.nyc_output/

# ── Agent / assistant scratch ────────────────────────────────────────────────
.claude/
RUN_LOCAL.md
dev-local.sh
SETUP.md
DEPLOYMENT.html