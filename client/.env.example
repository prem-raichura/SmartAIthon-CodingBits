# Copy this file to .env.local.
#
# Backend API URL. Leave blank (or remove the line) to run in mock-data mode,
# where charts render from src/mocks/*.json and login is unavailable.
VITE_API_URL=http://localhost:4000/api

# Flask analytics/model service (model/app.py). The browser posts CSV uploads
# straight here, so it must be reachable from the browser and send CORS headers.
VITE_PY_URL=http://localhost:8077
